# StyleSnap 配置 / StyleSnap configuration
# 复制为 .env 并填入 / Copy to .env and fill in

# Replicate API token（https://replicate.com/account/api-tokens）
# 留空则自动进入演示模式 / Leave empty to auto-enable demo mode
REPLICATE_API_TOKEN=

# 使用的 InstantID 模型 / InstantID model on Replicate
# 默认 zedge/instantid（含 input_image + ip_adapter_scale 字段）
REPLICATE_MODEL=zedge/instantid

# 强制演示模式 / Force demo mode: 1 / true / on
MOCK_MODE=

# 服务端口 / Server port
PORT=8000
